generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id

  name        String
  middleName  String    @default("")
  lastName    String
  password    String
  // People sign in with email; phone is kept for accounts created before email sign-in.
  email       String?   @unique
  phoneNumber String?   @unique
  sessions    Session[]
  imageURL    String    @default("")
  dateOfBirth String    @default("")
  firstTimer  Boolean   @default(true)
  // Language for emails sent without a request (reminders, scheduled rounds); "" means the default.
  locale      String    @default("")

  memberships    Membership[]
  assignments    Assignment[]
  passwordResets PasswordReset[]
  summaries      UserSummary[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// A company or team using Prisma. Everything people submit belongs to one.
model Organization {
  id      String @id @default(uuid())
  name    String
  // The name lowercased with spaces collapsed, so names are unique regardless of case.
  nameKey String @unique
  slug    String @unique

  // Whether respondents may see their own results (shown from phase 8 on).
  respondentFeedback Boolean @default(false)
  // Who respondents contact about their data; shown in the privacy notice.
  privacyContact     String  @default("")

  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  rounds      Round[]
  schedules   RoundSchedule[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// A person's place in an organization. Role keys are in src/utils/roles.ts.
model Membership {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           String       @default("member")
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId         String?
  position       String       @default("")
  // Restricted follow-up flag (src/utils/flags.ts); only psychologists see it.
  flag           String       @default("")
  // When the person agreed to this organization's privacy notice.
  consentedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  memberships    Membership[]
  invitations    Invitation[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Invitation {
  id             String       @id @default(uuid())
  // SHA-256 of the token in the link; the token itself is never stored.
  tokenHash      String       @unique
  email          String
  name           String       @default("")
  lastName       String       @default("")
  role           String       @default("member")
  position       String       @default("")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId         String?
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime

  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId String
}

model Category {
  id           String @id @default(uuid())
  name         String
  translations String @default("{}") // see src/utils/content-translation.ts
  forms        Form[]
  tests        Test[]
}

model Form {
  id          String @id @default(uuid())
  name        String @unique
  description String @default("")

  ttc       Int     @default(5)
  group     String  @default("")
  questions String
  adminOnly Boolean @default(false)

  translations String @default("{}") // see src/utils/content-translation.ts

  // Null for the shared library; otherwise the organization that uploaded it.
  organizationId String?

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id String @id @default(uuid())

  organizationId String
  userId         String
  formId         String
  submission     String
  // The round assignment this answers, if it was sent as part of one.
  assignmentId   String?
  // JSON: { "<questionId>": milliseconds spent answering }, for answer-quality checks.
  timings        String  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id String @id @default(uuid())

  ttc         Int    @default(5)
  name        String @unique
  description String @default("")
  instruction String @default("")

  scales    String
  strategy  String
  questions String

  stanTable    String
  tGradeTable  String
  summaryTable String

  translations String @default("{}") // see src/utils/content-translation.ts

  // Null for the shared library; otherwise the organization that uploaded it.
  organizationId String?
  // Clinical and wellbeing screens: only psychologists see them and their results.
  sensitive      Boolean @default(false)
  // Days before the same person may take this test again in a round (ability tests).
  retestDays     Int     @default(0)

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestSubmission {
  id String @id @default(uuid())

  organizationId String
  userId         String
  testId         String
  summary        String
  submission     String
  // The round assignment this answers, if it was sent as part of one.
  assignmentId   String?
  // JSON: { "<questionId>": milliseconds spent answering }, for answer-quality checks.
  timings        String  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSummary {
  id              String   @id @default(uuid())
  organizationId  String
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  verdict         String
  additionalNotes String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, organizationId])
}

// A set of instruments sent to people with a purpose and a due date.
model Round {
  id             String         @id @default(uuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  // hiring, development or wellbeing (src/utils/rounds.ts)
  purpose        String
  message        String         @default("")
  // JSON: [{ "kind": "test" | "form", "id": "..." }]
  items          String
  dueAt          DateTime?
  closedAt       DateTime?
  schedule       RoundSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId     String?
  // Which repetition of its schedule this is, from 1.
  cycle          Int            @default(1)
  createdById    String
  assignments    Assignment[]
  createdAt      DateTime       @default(now())
}

// One person's part in a round.
model Assignment {
  id             String    @id @default(uuid())
  round          Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId        String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // JSON: the round's items this person takes (some can be skipped for retest intervals).
  items          String
  // SHA-256 of the sign-in link's token; the link signs the person in and opens the round.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  invitedAt      DateTime?
  remindedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([roundId, userId])
}

// Opens a new round every few months for fixed people or for a team as it changes.
model RoundSchedule {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  purpose        String
  message        String       @default("")
  items          String
  intervalMonths Int
  // Days each cycle stays open before it is due.
  dueDays        Int          @default(14)
  // JSON: team ids whose members at each cycle are included, plus user ids picked by hand.
  teamIds        String       @default("[]")
  userIds        String       @default("[]")
  nextRunAt      DateTime
  active         Boolean      @default(true)
  createdById    String
  rounds         Round[]
  createdAt      DateTime     @default(now())
}

// Answers in progress, saved as people go so they can resume on any device.
model Draft {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  // "test" or "form"
  kind           String
  instrumentId   String
  assignmentId   String?
  // JSON: { "<questionId>": choiceId or text }
  answers        String   @default("{}")
  // JSON: { "<questionId>": milliseconds }
  timings        String   @default("{}")
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId, kind, instrumentId])
}
