generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id

  name            String
  middleName      String    @default("")
  lastName        String
  password        String
  // People sign in with email; phone is kept for accounts created before email sign-in.
  email           String?   @unique
  phoneNumber     String?   @unique
  sessions        Session[]
  imageURL        String    @default("")
  dateOfBirth     String    @default("")
  firstTimer      Boolean   @default(true)
  // Language for emails sent without a request (reminders, scheduled rounds); "" means the default.
  locale          String    @default("")
  // Set once the person has shown they read this inbox: a verification link, an invitation,
  // a password reset or a round link. Unverified accounts can't send invitations or rounds.
  emailVerifiedAt DateTime?

  memberships        Membership[]
  emailVerifications EmailVerification[]
  assignments        Assignment[]
  passwordResets     PasswordReset[]
  summaries          UserSummary[]
  oauthAccounts      OAuthAccount[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// A company or team using Prisma. Everything people submit belongs to one.
model Organization {
  id      String @id @default(uuid())
  name    String
  // The name lowercased with spaces collapsed, for matching names regardless of case. Names are
  // not unique: two companies can share one, and only the slug tells them apart.
  nameKey String
  slug    String @unique

  // Whether respondents may see their own results (shown from phase 8 on).
  respondentFeedback       Boolean @default(false)
  // JSON array of test ids whose feedback page respondents may open, when respondentFeedback is on.
  feedbackTestIds          String  @default("[]")
  // JSON array of the organization's own profile fields (src/utils/profile-fields.ts).
  customFields             String  @default("[]")
  // Who respondents contact about their data; shown in the privacy notice.
  privacyContact           String  @default("")
  // Results older than this many months are deleted automatically; 0 keeps them.
  retentionMonths          Int     @default(0)
  // Candidates are erased this many months after their last round closed; 0 keeps them.
  candidateRetentionMonths Int     @default(0)

  memberships      Membership[]
  invitations      Invitation[]
  joinLinks        JoinLink[]
  teams            Team[]
  rounds           Round[]
  schedules        RoundSchedule[]
  subscription     Subscription?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  // Answers from the /start welcome: what the organization uses Calibre for and how big it is.
  goal             String          @default("")
  teamSize         String          @default("")
  // A demo organization with fictional people, created from /start. Its people are never emailed.
  isSample         Boolean         @default(false)
  // When an admin hid the setup checklist on Today.
  setupDismissedAt DateTime?

  @@index([nameKey])
}

// A person's place in an organization. Role keys are in src/utils/roles.ts.
model Membership {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           String       @default("member")
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId         String?
  position       String       @default("")
  // Restricted follow-up flag (src/utils/flags.ts); only psychologists see it.
  flag           String       @default("")
  // When the person agreed to this organization's privacy notice.
  consentedAt    DateTime?
  // When the person closed the card explaining their role, shown on their first visits.
  welcomedAt     DateTime?
  // Profile details kept per organization.
  managerId      String?
  startDate      String       @default("") // yyyy-mm-dd
  location       String       @default("")
  employmentType String       @default("") // see src/utils/profile-fields.ts
  tags           String       @default("[]") // JSON array of strings
  customValues   String       @default("{}") // JSON: { "<field key>": value }
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model Team {
  id             String       @id @default(uuid())
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  memberships    Membership[]
  invitations    Invitation[]
  joinLinks      JoinLink[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Invitation {
  id                String       @id @default(uuid())
  // SHA-256 of the token in the link; the token itself is never stored.
  tokenHash         String       @unique
  email             String
  name              String       @default("")
  lastName          String       @default("")
  role              String       @default("member")
  position          String       @default("")
  // Language of the invitation email, chosen by the inviter; "" means the inviter's language.
  locale            String       @default("")
  // Saved before the inviter confirmed their email; sent when they do.
  held              Boolean      @default(false)
  // The link from the first email keeps working after a reminder brings a new one.
  previousTokenHash String?      @unique
  // When the latest email went out, and how many automatic reminders followed it.
  sentAt            DateTime     @default(now())
  remindersSent     Int          @default(0)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  team              Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId            String?
  invitedById       String
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime     @default(now())
}

model PasswordReset {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  // "full" after signing in with a password; "link" after opening a round link, which only
  // reaches the person's own assessments, never the dashboard or account settings.
  scope     String   @default("full")

  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
  userId String
}

// A link that confirms a person owns their email address.
model EmailVerification {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Category {
  id           String @id @default(uuid())
  name         String
  translations String @default("{}") // see src/utils/content-translation.ts
  forms        Form[]
  tests        Test[]
}

model Form {
  id          String @id @default(uuid())
  // Unique within what an organization can see (checked in src/actions/studio).
  name        String
  description String @default("")

  ttc       Int     @default(5)
  group     String  @default("")
  questions String
  adminOnly Boolean @default(false)

  translations String @default("{}") // see src/utils/content-translation.ts

  // Published version; 0 until first published. Earlier versions are in InstrumentVersion.
  version      Int     @default(1)
  // JSON of unpublished edits from the studio, or "" when there are none.
  draft        String  @default("")
  copiedFromId String?

  // Null for the shared library; otherwise the organization that uploaded it.
  organizationId String?

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id String @id @default(uuid())

  organizationId String
  userId         String
  formId         String
  // The form's version when answered.
  formVersion    Int     @default(1)
  submission     String
  // The round assignment this answers, if it was sent as part of one.
  assignmentId   String?
  // JSON: { "<questionId>": milliseconds spent answering }, for answer-quality checks.
  timings        String  @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Test {
  id String @id @default(uuid())

  ttc         Int    @default(5)
  // Unique within what an organization can see (checked in src/actions/studio).
  name        String
  description String @default("")
  instruction String @default("")

  scales    String
  strategy  String
  questions String

  stanTable    String
  tGradeTable  String
  summaryTable String

  translations String @default("{}") // see src/utils/content-translation.ts

  // Null for the shared library; otherwise the organization that uploaded it.
  organizationId String?
  // Clinical and wellbeing screens: only psychologists see them and their results.
  sensitive      Boolean @default(false)
  // Days before the same person may take this test again in a round (ability tests).
  retestDays     Int     @default(0)

  // Published version; 0 until first published. Earlier versions are in InstrumentVersion.
  version      Int     @default(1)
  // JSON of unpublished edits from the studio, or "" when there are none.
  draft        String  @default("")
  copiedFromId String?

  categories Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestSubmission {
  id String @id @default(uuid())

  organizationId String
  userId         String
  testId         String
  // The test's version when answered; results are scored and shown with that version.
  testVersion    Int     @default(1)
  summary        String
  submission     String
  // The round assignment this answers, if it was sent as part of one.
  assignmentId   String?
  // JSON: { "<questionId>": milliseconds spent answering }, for answer-quality checks.
  timings        String  @default("{}")
  // Interface language when answered; the norms are Russian, so other languages get a warning.
  locale         String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The working draft of a person's report: background and conclusion, saved as they are typed.
model UserSummary {
  id              String   @id @default(uuid())
  organizationId  String
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?
  verdict         String
  additionalNotes String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, organizationId])
}

// A saved, numbered copy of a person's report. Later edits never change it.
model ReportVersion {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  version        Int
  background     String
  conclusion     String
  // JSON array of the test submission ids the report covered.
  submissionIds  String
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId, version])
  @@index([organizationId, userId])
}

// A set of instruments sent to people with a purpose and a due date.
model Round {
  id             String         @id @default(uuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  // hiring, development or wellbeing (src/utils/rounds.ts)
  purpose        String
  message        String         @default("")
  // JSON: [{ "kind": "test" | "form", "id": "..." }]
  items          String
  dueAt          DateTime?
  closedAt       DateTime?
  schedule       RoundSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId     String?
  // Which repetition of its schedule this is, from 1.
  cycle          Int            @default(1)
  createdById    String
  assignments    Assignment[]
  invitees       RoundInvitee[]
  createdAt      DateTime       @default(now())
}

// Someone invited to the organization but not yet joined, added to a round. They get their
// assignment when they accept the invitation.
model RoundInvitee {
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId   String
  email     String
  createdAt DateTime @default(now())

  @@id([roundId, email])
  @@index([email])
}

// One person's part in a round.
model Assignment {
  id             String    @id @default(uuid())
  round          Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId        String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // JSON: the round's items this person takes (some can be skipped for retest intervals).
  items          String
  // SHA-256 of the sign-in link's token; the link signs the person in and opens the round.
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  invitedAt      DateTime?
  remindedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([roundId, userId])
}

// Opens a new round every few months for fixed people or for a team as it changes.
model RoundSchedule {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  purpose        String
  message        String       @default("")
  items          String
  intervalMonths Int
  // Days each cycle stays open before it is due.
  dueDays        Int          @default(14)
  // JSON: team ids whose members at each cycle are included, plus user ids picked by hand.
  teamIds        String       @default("[]")
  userIds        String       @default("[]")
  nextRunAt      DateTime
  active         Boolean      @default(true)
  createdById    String
  rounds         Round[]
  createdAt      DateTime     @default(now())
}

// Answers in progress, saved as people go so they can resume on any device.
model Draft {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  // "test" or "form"
  kind           String
  instrumentId   String
  assignmentId   String?
  // JSON: { "<questionId>": choiceId or text }
  answers        String   @default("{}")
  // JSON: { "<questionId>": milliseconds }
  timings        String   @default("{}")
  updatedAt      DateTime @updatedAt

  @@unique([userId, organizationId, kind, instrumentId])
}

// A named set of analytics filters someone saved.
model AnalyticsView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  // The analytics page's query string, without the leading "?".
  query          String
  createdAt      DateTime @default(now())

  @@index([organizationId, userId])
}

// Who viewed or changed personal data and when. Details never hold scores or answers.
model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  // Null for automatic jobs such as retention clean-up.
  actorId        String?
  // See AUDIT_ACTIONS in src/utils/audit.ts.
  action         String
  // The person whose data was involved, if any.
  subjectId      String?
  // JSON with a few identifiers, e.g. { "testId": "...", "role": "admin" }.
  detail         String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, subjectId])
}

// A published version of a test or questionnaire, kept so older answers are shown and scored
// exactly as they were given.
model InstrumentVersion {
  id           String   @id @default(uuid())
  // "test" or "form"
  kind         String
  instrumentId String
  version      Int
  // JSON of the content fields (src/utils/instrument-content.ts) plus translations.
  content      String
  note         String   @default("")
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([kind, instrumentId, version])
}

// An organization's plan. Mirrors its Paddle subscription once it has one; before that it holds the
// local trial. Plans and what they unlock are in src/utils/plans.ts, the rules in src/utils/billing.ts.
model Subscription {
  id                   String       @id @default(uuid())
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String       @unique
  // free, team, business or enterprise
  plan                 String       @default("free")
  // trialing, active, past_due, paused or canceled (Paddle's statuses)
  status               String       @default("trialing")
  trialEndsAt          DateTime?
  paddleCustomerId     String?
  paddleSubscriptionId String?      @unique
  priceId              String?
  // month or year
  interval             String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  // When a scheduled cancellation takes effect.
  cancelAt             DateTime?
  // When the last payment failed; the plan stays usable for a grace period after it.
  pastDueSince         DateTime?
  // Time of the last Paddle event applied, so an older event arriving late never overwrites a newer one.
  paddleUpdatedAt      DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// Every Paddle webhook received, so each is applied once however often Paddle resends it.
model BillingEvent {
  id             String    @id @default(uuid())
  paddleEventId  String    @unique
  type           String
  organizationId String?
  payload        String
  processedAt    DateTime?
  error          String    @default("")
  createdAt      DateTime  @default(now())
}

// A shareable link that lets anyone with it join as an employee, within its limits.
model JoinLink {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  // Stored as is, unlike invitation tokens: the link is meant to be posted where the whole
  // team can see it, and admins copy it again later.
  token          String       @unique
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamId         String?
  expiresAt      DateTime
  // null means no limit.
  maxUses        Int?
  uses           Int          @default(0)
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// A Google or Microsoft identity someone signs in with.
model OAuthAccount {
  provider       String
  providerUserId String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  email          String   @default("")
  createdAt      DateTime @default(now())

  @@id([provider, providerUserId])
  @@index([userId])
}
