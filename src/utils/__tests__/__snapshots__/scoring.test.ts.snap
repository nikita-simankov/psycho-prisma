exports[`scoreSubmission on every bundled test > Методика выявления акцентуаций характера (Леонгард-Шмишек) > scores the "first" answer pattern 1`] = `
[
  {
    "correctedGrade": null,
    "rawGrade": 24,
    "scaleId": 1,
    "scaleName": "Шкала гипертимности",
    "stan": null,
    "summary": "Люди, склонные к повышенному настроению, оптимисты, быстро переключаются с одного дела на другое, не доводят начатого до конца, недисциплинированные, легко попадают под влияние неблагополучных компаний. Подростки склонны к приключениям, романтике. Не терпят власти над собой, но любят, когда их опекают. Тенденция к доминированию, лидированию. Высокие оценки говорят о постоянном повышенном фоне настроения в сочетании с жаждой деятельности, высокой активностью, предприимчивости. В патологии — невроз навязчивых идей",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 18,
    "scaleId": 2,
    "scaleName": "Шкала застревания",
    "stan": null,
    "summary": "Имеется тенденция к акцентуации",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 21,
    "scaleId": 3,
    "scaleName": "Шкала эмотивности",
    "stan": null,
    "summary": "Аффектно лабильные (неустойчивые). Люди, у которых быстро и резко меняется настроение по незначительному для окружающих поводу. От настроения зависит все — и работоспособность, и самочувствие и т. д. Тонко организована эмоциональная сфера; способны глубоко чувствовать и переживать. Склонны к добрым отношениям с окружающими. В любви ранимы как никто. Не против того, чтобы их опекали, заботились. Лицам этого типа свойственен большой диапазон эмоциональных состояний, они легко приходят в восторг от радостных событий и в полное отчаяние от печальных.",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 22,
    "scaleId": 4,
    "scaleName": "Шкала педантичности",
    "stan": null,
    "summary": "Преобладание черт ригидности и педантизма. Люди ригидны, им трудно переключаться с одной эмоции на другую. Любят, чтобы все было на своих местах, чтобы люди четко оформляли свои мысли, — крайний педантизм. Периоды злобно-тоскливого настроения, все их раздражает. В патологии — эпилептоидная психопатия. Могут проявлять агрессию (долго помнят и выливают). Высокие оценки говорят о ригидности, инертности психических процессов, о долгом переживании травмирующих событий.",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 21,
    "scaleId": 5,
    "scaleName": "Шкала тревожности",
    "stan": null,
    "summary": "Люди меланхолического склада с очень высоким уровнем конституционной тревожности, не уверены в себе. Недооценивают, преуменьшают свои способности. Застенчивы, пугаются ответственности. Основная черта - склонность к страхам, повышенная робость и пугливость.",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 24,
    "scaleId": 6,
    "scaleName": "Шкала циклотимности",
    "stan": null,
    "summary": "Резкие перепады настроения. Хорошее настроение коротко, плохое длительно. При депрессии ведут себя как тревожные, быстро утомляются, снижается творческая активность. Людям с высокими оценками по этой шкале соответствует смена гипертимических и дистимических фаз (при хорошем настроении как гипертивные).",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 22,
    "scaleId": 7,
    "scaleName": "Шкала демонстративности",
    "stan": null,
    "summary": "В патологии — психопатия истерического типа. Люди, у которых сильно выражен эгоцентризм, стремление быть постоянно в центре внимания («пусть ненавидят, лишь бы не были равнодушными»). Много таких людей среди артистов. Если нет способностей, чтобы выделиться, они привлекают внимание антисоциальными поступками. Патологическая лживость - чтобы приукрасить свою особу. Склонны носить яркую, экстравагантную одежду - могут быть определены чисто внешне. Высокие оценки по этой шкале говорят о повышенной способности к вытеснению, демонстративности поведения. ",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 24,
    "scaleId": 8,
    "scaleName": "Шкала возбудимости",
    "stan": null,
    "summary": "Склонность к повышенной импульсивной реактивности в сфере влечения. Таким людям свойственна повышенная импульсивность, ослабление контроля над влечениями и побуждениями. В патологии — эпилептоидная психопатия.",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 15,
    "scaleId": 9,
    "scaleName": "Шкала дистимности",
    "stan": null,
    "summary": "Имеется тенденция к акцентуации",
    "tGrade": null,
  },
  {
    "correctedGrade": null,
    "rawGrade": 24,
    "scaleId": 10,
    "scaleName": "Шкала экзальтированности",
    "stan": null,
    "summary": "Склонность к аффективной экзальтации (близко к демонстративности, но там из-за характера). Здесь идут те же проявления, но на уровне эмоций (все идет от темперамента). Религиозный экстаз. Это чувствительные и впечатлительные люди, отличаются глубиной переживаний в области тонких эмоций в духовной жизни человека.",
    "tGrade": null,
  },
]
`;

