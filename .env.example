# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# First owner account and its organization, created by `npm run db:seed`
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"
ORGANIZATION_NAME="My organization"

# Public address used in invitation and password reset links (defaults to the request host)
APP_URL="http://localhost:3000"

# Email through Resend. Without a key, emails are printed to the server log
# and invitation links can be copied from the People page.
RESEND_API_KEY=""
MAIL_FROM="Prisma <no-reply@example.com>"
