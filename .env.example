# Postgres; `docker compose up -d` starts one with these settings
DATABASE_URL="postgresql://prisma:prisma@localhost:5432/prisma"

# First owner account and its organization, created by `npm run db:seed`
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"
ORGANIZATION_NAME="My organization"

# Public address used in invitation and password reset links (defaults to the request host)
APP_URL="http://localhost:3000"

# Email through Resend. Without a key, emails are printed to the server log
# and invitation links can be copied from the People page.
RESEND_API_KEY=""
MAIL_FROM="Prisma <no-reply@example.com>"

# Proxies in front of the app. Rate limits read the client address from the entry the
# last of them appended to X-Forwarded-For; 0 ignores the header (no proxy in front).
TRUSTED_PROXY_COUNT="1"

# Paddle billing (optional; see README.md). Without it organizations stay on trials and Free.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_TEAM=""
PADDLE_PRICE_BUSINESS=""

# Sign in with Google or Microsoft (optional). Redirect URI: $APP_URL/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# The hourly job runs inside the server. To run it from an external scheduler instead, set
# DISABLE_SCHEDULER=1 and POST /api/cron with "Authorization: Bearer $CRON_SECRET".
DISABLE_SCHEDULER=""
CRON_SECRET=""

# Receives a JSON report of each server error (optional; Slack-style incoming webhooks work).
ERROR_WEBHOOK_URL=""
